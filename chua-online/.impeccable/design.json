  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Main form and practice actions on cream reading surfaces.",
      "html": "<button class=\"ds-primary\">Vào chùa <svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.65\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14\"/><path d=\"m12 5 7 7-7 7\"/></svg></button>",
      "css": ".ds-primary{font-family:BeVietnam,'Segoe UI',sans-serif;min-height:45px;display:inline-flex;justify-content:center;align-items:center;gap:10px;padding:11px 17px;border:0;border-radius:7px;font-weight:600;font-size:12px;cursor:pointer;transition:background-color .18s,color .18s;background:var(--primary,#743422);color:#fff9e9}.ds-primary svg{width:16px;height:16px}.ds-primary:hover{background:var(--primary-hover,#90452d)}.ds-primary:focus-visible{outline:3px solid #c79945;outline-offset:4px;}.ds-primary:disabled{cursor:wait;opacity:.5}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Supporting and trailing list actions on cream.",
      "html": "<button class=\"ds-secondary\">Thỉnh vật phẩm</button>",
      "css": ".ds-secondary{font-family:BeVietnam,'Segoe UI',sans-serif;min-height:45px;display:inline-flex;justify-content:center;align-items:center;gap:10px;padding:11px 17px;border:0;border-radius:7px;font-weight:600;font-size:12px;cursor:pointer;transition:background-color .18s,color .18s;background:#e8e2d5;color:var(--ink,#34271e)}.ds-secondary:hover{background:#dcd3c1}.ds-secondary:focus-visible{outline:3px solid #c79945;outline-offset:4px;}.ds-secondary:disabled{cursor:wait;opacity:.5}@media(prefers-reduced-motion:reduce){.ds-secondary{transition:none}}"
    },
    {
      "name": "Paper Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Visible label, warm field fill, and a clear stroke for names and account details.",
      "html": "<label class=\"ds-field\">Pháp danh của bạn<input name=\"name\" value=\"An Nhiên\" autocomplete=\"nickname\"></label>",
      "css": ".ds-field{font-family:BeVietnam,'Segoe UI',sans-serif;display:flex;flex-direction:column;gap:9px;font-size:12px;font-weight:600;color:var(--ink,#34271e)}.ds-field input{font-family:BeVietnam,'Segoe UI',sans-serif;box-sizing:border-box;min-height:44px;width:100%;background:var(--paper,#fffaf0);color:var(--ink,#34271e);border:1px solid #b7af9f;border-radius:6px;padding:10px 12px;font-size:14px;font-weight:400;caret-color:var(--primary,#743422)}.ds-field input::placeholder{color:#746a5b;opacity:1}.ds-field input:focus-visible{outline:3px solid #c79945;outline-offset:4px;}"
    },
    {
      "name": "Temple Navigation",
      "kind": "nav",
      "refersTo": "navigation",
      "description": "Labeled desktop rail; the same content becomes the single phone drawer.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Danh mục trong chùa\"><button class=\"ds-current\"><svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.65\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 10c4 0 6-2 9-7 3 5 5 7 9 7H3Z\"/><path d=\"M5 10v11m14-11v11M3 21h18M9 21v-7h6v7M10 6h4\"/></svg><span>Chánh điện</span></button><button><svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.65\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z\"/><path d=\"M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12\"/></svg><span>Thiền phái</span></button></nav>",
      "css": ".ds-nav{width:142px;display:flex;flex-direction:column;padding:9px;background:var(--hud,#2b1510ed);border-radius:var(--radius,12px)}.ds-nav button{font-family:BeVietnam,'Segoe UI',sans-serif;display:flex;align-items:center;gap:11px;min-height:43px;background:transparent;color:#e4e5d8;text-align:left;font-size:11px;padding:9px 10px;border:0;border-radius:7px;cursor:pointer;transition:background-color .18s,color .18s}.ds-nav svg{width:18px;height:18px;flex-shrink:0}.ds-nav button:hover,.ds-nav .ds-current{background:#e0d6a91c;color:#efd3a0}.ds-nav button:focus-visible{outline:3px solid #c79945;outline-offset:4px;}@media(max-width:800px){.ds-nav{width:164px;max-height:calc(100dvh - 185px);overflow-y:auto;box-shadow:var(--shadow,0 16px 48px #1b080854)}.ds-nav button{font-size:12px;min-height:44px}}@media(prefers-reduced-motion:reduce){.ds-nav button{transition:none}}"
    },
    {
      "name": "Practice Dock",
      "kind": "nav",
      "refersTo": "practice-dock",
      "description": "Seven icon-above-label practice actions; the phone layout shares space and wraps labels with 44px minimum action widths.",
      "html": "<nav class=\"ds-dock\" aria-label=\"Hoạt động tu tập\"><button><svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.65\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M11 14h2a2 2 0 0 0 0-4h-3c-.6 0-1.1.2-1.4.6L3 16\"/><path d=\"m14.45 13.39 5.05-4.694C20.196 8 21 6.85 21 5.75a2.75 2.75 0 0 0-4.797-1.837.276.276 0 0 1-.406 0A2.75 2.75 0 0 0 11 5.75c0 1.2.802 2.248 1.5 2.946L16 11.95\"/><path d=\"m2 15 6 6\"/><path d=\"m7 20 1.6-1.4c.3-.4.8-.6 1.4-.6h4c1.1 0 2.1-.4 2.8-1.2l4.6-4.4a1 1 0 0 0-2.75-2.91\"/></svg><span>Lạy Phật</span></button><button class=\"ds-active\"><svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.65\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><circle cx=\"12\" cy=\"12\" r=\"1\"/></svg><span>Tràng hạt</span></button><button><svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.65\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 7v14\"/><path d=\"M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z\"/></svg><span>Tụng kinh</span></button><span class=\"ds-dock-seam\"></span><button><svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.65\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z\"/><path d=\"M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12\"/></svg><span>Thiền định</span></button><button><svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.65\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 5a3 3 0 1 1 3 3m-3-3a3 3 0 1 0-3 3m3-3v1M9 8a3 3 0 1 0 3 3M9 8h1m5 0a3 3 0 1 1-3 3m3-3h-1m-2 3v-1\"/><circle cx=\"12\" cy=\"8\" r=\"2\"/><path d=\"M12 10v12\"/><path d=\"M12 22c4.2 0 7-1.667 7-5-4.2 0-7 1.667-7 5Z\"/><path d=\"M12 22c-4.2 0-7-1.667-7-5 4.2 0 7 1.667 7 5Z\"/></svg><span>Dâng lễ</span></button><button><svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.65\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M10.268 21a2 2 0 0 0 3.464 0\"/><path d=\"M3.262 15.326A1 1 0 0 0 4 17h16a1 1 0 0 0 .74-1.673C19.41 13.956 18 12.499 18 8A6 6 0 0 0 6 8c0 4.499-1.411 5.956-2.738 7.326\"/></svg><span>Thỉnh chuông</span></button><button><svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.65\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 12v6\"/><path d=\"M4.077 10.615A1 1 0 0 0 5 12h14a1 1 0 0 0 .923-1.385l-3.077-7.384A2 2 0 0 0 15 2H9a2 2 0 0 0-1.846 1.23Z\"/><path d=\"M8 20a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v1a1 1 0 0 1-1 1H9a1 1 0 0 1-1-1z\"/></svg><span>Hoa đăng</span></button></nav>",
      "css": ".ds-dock{display:flex;align-items:center;width:max-content;max-width:100%;padding:9px 12px;border-radius:12px;background:var(--hud,#2b1510ed);color:var(--text-on-dark,#f1eadb);box-shadow:0 8px 20px #1b080830}.ds-dock button{font-family:BeVietnam,'Segoe UI',sans-serif;height:63px;width:76px;padding:7px 6px;display:flex;align-items:center;flex-direction:column;justify-content:center;gap:8px;background:transparent;color:inherit;border:0;border-radius:8px;white-space:nowrap;cursor:pointer;transition:background-color .18s,color .18s}.ds-dock button:hover,.ds-dock .ds-active{background:#d2c09920;color:var(--gold,#e8c77d)}.ds-dock svg{width:23px;height:23px;color:#ddc798;flex-shrink:0}.ds-dock span{font-size:10px}.ds-dock-seam{width:1px;height:35px;background:#c3ccba2e;margin:0 5px}.ds-dock button:focus-visible{outline:3px solid #c79945;outline-offset:4px;}@media(max-width:1200px){.ds-dock button{width:69px}}@media(max-width:800px){.ds-dock{padding:6px;overflow-x:auto;scrollbar-width:none}.ds-dock button{width:59px;min-width:59px;gap:7px}.ds-dock svg{width:21px;height:21px}.ds-dock span{font-size:9px}.ds-dock-seam{margin:0 3px;min-width:1px;height:30px}}@media(prefers-reduced-motion:reduce){.ds-dock button{transition:none}}@media(max-width:800px){.ds-dock{width:calc(100% - 24px)}.ds-dock button{flex:1;width:auto;min-width:44px;height:68px;gap:5px}.ds-dock button span{white-space:normal;text-align:center;line-height:1.4;max-width:48px}}"
    },
    {
      "name": "Reading Panel",
      "kind": "card",
      "refersTo": "reading-panel",
      "description": "An opaque reading surface with a fixed header and independently scrollable task content; it is an aside, not a modal.",
      "html": "<aside class=\"ds-panel\" aria-labelledby=\"ds-title\"><header class=\"ds-panel-head\"><h2 id=\"ds-title\">Lần tràng hạt</h2><button aria-label=\"Đóng bảng\"><svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.65\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M18 6 6 18\"/><path d=\"m6 6 12 12\"/></svg></button></header><div class=\"ds-panel-content\"><p>Mỗi hạt là một câu niệm. Chậm rãi, an trú trong hiện tại.</p></div></aside>",
      "css": ".ds-panel{font-family:BeVietnam,'Segoe UI',sans-serif;width:385px;max-width:100%;border-radius:14px;background:var(--cream,#f7efdf);color:var(--ink,#34271e);box-shadow:var(--shadow,0 16px 48px #1b080854);display:flex;flex-direction:column;overflow:hidden}.ds-panel-head{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:22px 22px 17px;border-bottom:1px solid var(--line,#dfcfb6)}.ds-panel h2{font-family:NotoSerif,Georgia,serif;margin:0;font-size:23px;line-height:1.4;font-weight:500;letter-spacing:-.025em}.ds-panel-head button{width:40px;height:40px;display:grid;place-items:center;border:0;border-radius:6px;background:transparent;color:inherit;cursor:pointer;transition:background-color .18s,color .18s}.ds-panel-head button:hover{background:#dbd5c4}.ds-panel-head button:focus-visible{outline:3px solid #c79945;outline-offset:4px;}.ds-panel svg{width:20px;height:20px}.ds-panel-content{padding:22px;overflow:auto;scrollbar-width:thin;scrollbar-color:#b99e74 transparent;overscroll-behavior:contain;flex:1}.ds-panel p{font-size:12px;color:var(--muted,#74604e);max-width:65ch;line-height:1.75;margin:0}@media(max-width:800px){.ds-panel{width:370px;border-radius:12px}.ds-panel-head{padding:17px 19px 13px}.ds-panel h2{font-size:22px}.ds-panel-head button{width:44px;height:44px}.ds-panel-content{padding:19px}}@media(prefers-reduced-motion:reduce){.ds-panel-head button{transition:none}}"
    },
    {
      "name": "Duration Choice",
      "kind": "chip",
      "refersTo": "duration-option",
      "description": "A real meditation-duration task selection; selection uses lacquer and ivory. Source defines focus and selected states without a separate hover fill.",
      "html": "<div class=\"ds-duration\" aria-label=\"Thời lượng thiền\"><button class=\"ds-selected\">5 phút</button><button>10 phút</button><button>20 phút</button></div>",
      "css": ".ds-duration{display:flex;justify-content:center;gap:7px;flex-wrap:wrap;margin:22px 0}.ds-duration button{font-family:BeVietnam,'Segoe UI',sans-serif;padding:10px;border:0;border-radius:5px;background:#e5dfd0;color:var(--ink,#34271e);min-height:40px;font-size:11px;cursor:pointer;transition:background-color .18s,color .18s}.ds-duration .ds-selected{background:var(--primary,#743422);color:var(--cream,#f7efdf)}.ds-duration button:focus-visible{outline:3px solid #c79945;outline-offset:4px;}.ds-duration button:disabled{opacity:.5;cursor:wait}@media(max-width:800px){.ds-duration button{min-height:44px}}@media(prefers-reduced-motion:reduce){.ds-duration button{transition:none}}"
    },
    {
      "name": "Bead Action",
      "kind": "custom",
      "refersTo": "bead-button",
      "description": "The large circular practice control under a tabular serif count; phone diameter is 120px.",
      "html": "<button class=\"ds-bead\"><svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.65\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><circle cx=\"12\" cy=\"12\" r=\"1\"/></svg><span>Lần một hạt</span></button>",
      "css": ".ds-bead{font-family:BeVietnam,'Segoe UI',sans-serif;border:1px solid #c6aa79;background:#e8d8b6;color:#5d4322;border-radius:50%;width:146px;height:146px;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:15px;margin:18px auto 25px;font-size:13px;box-shadow:0 8px 18px #705b2520;cursor:pointer;transition:background-color .18s,color .18s}.ds-bead svg{width:45px;height:45px;stroke-width:1.3}.ds-bead:hover{background:#ddca9e}.ds-bead:active{transform:scale(.98)}.ds-bead:focus-visible{outline:3px solid #c79945;outline-offset:4px;}@media(max-width:800px){.ds-bead{width:120px;height:120px}}@media(prefers-reduced-motion:reduce){.ds-bead{transition:none}}"
    },
    {
      "name": "Movement Joystick",
      "kind": "custom",
      "refersTo": "movement-joystick",
      "description": "112px captured-pointer touch control with 45px thumb and a 12% movement dead zone. The product owns one active pointer; release, cancel, lost capture, blur, hidden document, and panel opening reset movement. This preview shows visual states only.",
      "html": "<button class=\"ds-joystick\" aria-label=\"Kéo để di chuyển\"><span class=\"ds-stick-track\"></span><span class=\"ds-stick-thumb\"><svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.65\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 3v18M3 12h18m-6-6-3-3-3 3m6 12-3 3-3-3M6 9l-3 3 3 3m12-6 3 3-3 3\"/></svg></span></button>",
      "css": ".ds-joystick{position:relative;width:112px;height:112px;min-width:112px;min-height:112px;border-radius:50%;background:#2b1510eb;border:1px solid #e8c77d70;touch-action:none;user-select:none;cursor:grab;display:block;padding:0;color:var(--gold,#e8c77d)}.ds-stick-track{position:absolute;inset:20px;border:1px solid #e8c77d29;border-radius:50%;pointer-events:none}.ds-stick-thumb{position:absolute;left:50%;top:50%;width:45px;height:45px;border-radius:50%;display:grid;place-items:center;background:#69452a;transform:translate(-50%,-50%);pointer-events:none;box-shadow:0 4px 12px #1b080830}.ds-stick-thumb svg{width:21px;height:21px}.ds-joystick:active{background:#48251a;cursor:grabbing}.ds-joystick:active .ds-stick-thumb{background:#8a6037}.ds-joystick:focus-visible{outline:3px solid #c79945;outline-offset:4px}.ds-joystick:disabled{opacity:.5;cursor:default}"
    },
    {
      "name": "Camera Selector",
      "kind": "custom",
      "refersTo": "camera-selector",
      "description": "Native camera select offering the four interior presets and character follow; hidden while welcome/task panels are open.",
      "html": "<label class=\"ds-camera\"><svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.65\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 7V5a2 2 0 0 1 2-2h2M17 3h2a2 2 0 0 1 2 2v2M21 17v2a2 2 0 0 1-2 2h-2M7 21H5a2 2 0 0 1-2-2v-2\"/><circle cx=\"12\" cy=\"12\" r=\"1\"/><path d=\"M18.944 12.33a1 1 0 0 0 0-.66 7.5 7.5 0 0 0-13.888 0 1 1 0 0 0 0 .66 7.5 7.5 0 0 0 13.888 0\"/></svg><select aria-label=\"Góc nhìn đại điện\"><option>Theo nhân vật</option><option>Chính diện</option><option>Góc bên trái</option><option>Góc bên phải</option><option>Nhìn từ trên cao</option></select></label>",
      "css": ".ds-camera{display:inline-flex;flex-direction:row;align-items:center;gap:8px;background:var(--hud,#2b1510ed);color:var(--gold,#e8c77d);border-radius:7px;padding:0 10px;box-shadow:0 5px 15px #16090425}.ds-camera svg{width:16px;height:16px;flex-shrink:0}.ds-camera select{font-family:BeVietnam,'Segoe UI',sans-serif;font-weight:400;width:145px;border:0;border-radius:6px;background:transparent;color:var(--text-on-dark,#f1eadb);font-size:11px;padding:10px 19px 10px 2px;min-height:38px;cursor:pointer}.ds-camera option{background:var(--night,#23120d);color:var(--cream,#f7efdf)}.ds-camera select:focus-visible{outline:3px solid #c79945;outline-offset:4px}@media(max-width:800px){.ds-camera{padding:0 8px}.ds-camera select{min-height:44px;width:140px}}"
    }
  ],
  "narrative": {
    "northStar": "The Inhabitable Grand Sanctuary",
